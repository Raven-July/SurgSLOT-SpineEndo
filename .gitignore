# IDE
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Experiment outputs
# Unanchored rules apply to every backbone directory.
*_logs/
outputs/
results/
logs/
wandb/
tmp/

# Data and model weights
# Dataset payloads at the repository root or directly under a backbone.
# Keep configuration groups such as sam2/.../configs/.../datasets tracked.
/data/
/datasets/
/*/data/
/*/datasets/
checkpoints/*.pt
checkpoints/*.pth
checkpoints/*.ckpt
checkpoints/*.safetensors
*.pt
*.pth
*.ckpt
*.safetensors

# Local working material
/work/

# Build artifacts
build/
dist/
/sam2/_C.*
